import "../../lib/vec.ep"
import "../../lib/option.ep"
import "runtime_variant.ep"
postulate Token : Type 0
postulate RuntimeScalar : Type 0
proc importedIntIdentity : Int -> Int = lam (value : Int). value
proc importedNullaryInt : Pi (_ : 1). Int = lam (_ : 1). addInt 40 2
proc importedGenericIdentity (A : Type 0) (value : A) : A = value
proc importedGenericCallbackApply (A : Type 0) (callback : A -> A)
    (value : A) : A = callback value
proc importedGenericDependentVectorCallbackApply (A : Type 0)
    (callback : Pi (n : Nat). Vec A n -> Vec A n) (n : Nat)
    (values : Vec A n) : Vec A n = callback n values
proc importedGenericOptionCallbackApply (A : Type 0)
    (callback : Option A -> Option A) (value : Option A) : Option A =
    callback value
proc importedGenericSigmaCallbackApply (A : Type 0)
    (callback : (Sig (left : A). A) -> (Sig (left : A). A))
    (value : Sig (left : A). A) : Sig (left : A). A = callback value
proc importedGenericDependentPairCallbackApply (A : Type 0)
    (callback : (Sig (length : Nat). Vec A length) ->
      (Sig (length : Nat). Vec A length))
    (value : Sig (length : Nat). Vec A length) :
    Sig (length : Nat). Vec A length = callback value
proc importedGenericSingleton (A : Type 0) (value : A) :
    Vec A (suc zero) = cons A zero value (nil A)
proc importedImplicitGenericIdentity {A : Type 0} (value : A) : A = value
proc importedImplicitNatVecIdentity {n : Nat} (values : Vec Int n) : Vec Int n = values
proc importedImplicitBoolIdentity {flag : Bool} : Bool = flag
proc importedImplicitIntIdentity {number : Int} : Int = number
proc importedImplicitTokenIdentity {token : Token} : Token = token
proc importedCallbackApply (f : Int -> Int) (value : Int) : Int = f value
proc importedCallbackApply2 (f : Int -> Int -> Int) (left : Int) (right : Int) : Int = f left right
proc importedCallbackIdentity (f : Int -> Int) : Int -> Int = f
proc applyNullaryCallback (callback : Pi (_ : 1). Int) : Int =
  callback <>
proc nullaryCallbackIdentity (callback : Pi (_ : 1). Int) :
    Pi (_ : 1). Int = callback
proc importedDependentCallbackApply (f : Pi (n : Nat). Vec Int n) (n : Nat) : Vec Int n = f n
proc importedDependentPairIdentity (pair : Sig (n : Nat). Vec Int n) : Sig (n : Nat). Vec Int n = pair
