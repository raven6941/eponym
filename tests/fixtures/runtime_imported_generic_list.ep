import "../../lib/list.ep"
import "../../lib/option.ep"
import "runtime_variant.ep"
proc importedGenericListCallbackApply (A : Type 0)
    (callback : List A -> List A) (value : List A) : List A =
    callback value
proc importedGenericIndexedListCallbackApply (A : Type 0)
    (callback : List A -> List A) (value : List A) : List A = callback value
proc importedGenericIndexedOptionListCallbackApply (A : Type 0)
    (callback : Option (List A) -> Option (List A))
    (value : Option (List A)) : Option (List A) = callback value
