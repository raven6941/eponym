import "../../lib/nat.ep"
import "../../lib/vec.ep"

postulate(Int, Univ)
data(RuntimeTree, Univ) where
| treeEmpty : RuntimeTree
| treeNode (value : Int) (tail : RuntimeTree) : RuntimeTree
proc treeIdentity : RuntimeTree -> RuntimeTree =
  lam(tree: RuntimeTree) => tree
data(SizedTree, [length: Nat], Univ) where
| sizedTree (tree : RuntimeTree) : SizedTree length
data(SizedVector, [length: Nat], Univ) where
| sizedVector (values : Vec Int length) : SizedVector length
data(OtherTree, Univ) where
| otherTree : OtherTree
