# Eponym common library: length-indexed vectors (issue #54).
#
# import nat
# import eq

data Vec (A : ?) : Nat -> ? where
| nil : Vec A zero
| cons (n : Nat) (x : A) (xs : Vec A n) : Vec A (suc n)

proc vappend {A : ?} {m : Nat} {n : Nat} (xs : Vec A m) (ys : Vec A n)
    : Vec A (add m n) =
  vecElim A (lam (i : Nat). lam (v : Vec A i). Vec A (add i n))
            ys
            (lam (i : Nat). lam (x : A). lam (xs2 : Vec A i).
              lam (ih : Vec A (add i n)). cons A (add i n) x ih)
            m xs

proc vmap {A : ?} {B : ?} {n : Nat} (f : A -> B) (xs : Vec A n) : Vec B n =
  vecElim A (lam (i : Nat). lam (v : Vec A i). Vec B i)
            (nil B)
            (lam (i : Nat). lam (x : A). lam (xs2 : Vec A i).
              lam (ih : Vec B i). cons B i (f x) ih)
            n xs

# NOTE (issue #54, step 3): `vmapId` — `Eq (Vec A n) (vmap id xs) xs` by
# induction — does NOT elaborate: the nil-case fails with
# "cannot unify tV with tApp". A motive that applies a defined proc with
# implicits solved to the bound index variable (here `vmap ... v`, {n} := i)
# breaks vecElim's case-type instantiation. Filed as a follow-up issue with
# a minimal repro; the getLen analogue (vectest5) works, so the trigger is
# specific to unfolding a vecElim-defined proc in the motive.
