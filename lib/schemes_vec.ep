# Eponym common library: recursion schemes, Vec (issue #48).
#
# Companion to `schemes.ep` (Nat + List schemes). Split into its own module
# because `import` merges unqualified (issue #49, v1 decision): List's and
# Vec's `nil`/`cons` constructors would collide in a single importing
# module. See decisions.org.
#
import "nat.ep"
import "vec.ep"
import "eq.ep"

# The catamorphism for Vec: `vecElim`, renamed. The motive ranges over the
# index as well as the vector — dependent folds come for free.
proc cataVec (A : ?) (P : (i : Nat) -> Vec A i -> ?)
    (nilC : P zero (nil A))
    (consC : (i : Nat) -> (x : A) -> (xs2 : Vec A i) -> P i xs2
               -> P (suc i) (cons A i x xs2))
    (n : Nat) (xs : Vec A n) : P n xs =
  vecElim A P nilC consC n xs

# Map fusion for Vec: `vmap g (vmap f xs) = vmap (g . f) xs`. Same shape
# as `vmapId` in vec.ep: nil-case by conversion, cons-case by `cong`
# over the constructor with the induction hypothesis.
proc vmapFusion (A : ?) (B : ?) (C : ?) (f : A -> B) (g : B -> C)
    (n : Nat) (xs : Vec A n)
    : Eq (Vec C n) (vmap g (vmap f xs))
                   (vmap (lam (x : A). g (f x)) xs) =
  cataVec A (lam (i : Nat). lam (v : Vec A i).
              Eq (Vec C i) (vmap g (vmap f v))
                               (vmap (lam (x : A). g (f x)) v))
          (refl (Vec C zero) (nil C))
          (lam (i : Nat). lam (x : A). lam (xs2 : Vec A i).
            lam (ih : Eq (Vec C i) (vmap g (vmap f xs2))
                                       (vmap (lam (x : A). g (f x)) xs2)).
              cong (Vec C i) (Vec C (suc i))
                   (lam (t : Vec C i). cons C i (g (f x)) t)
                   (vmap g (vmap f xs2))
                   (vmap (lam (x : A). g (f x)) xs2) ih)
          n xs
