nimcache/
*.o
# Compiled Nim binaries: `nim c` drops extensionless binaries next to
# sources. Ignore all extensionless files under src/ and tests/, keeping
# directories and .nim sources.
src/**
!src/**/
!src/**/*.nim
!src/**/*.md
tests/**
!tests/**/
!tests/**/*.nim
!tests/**/*.sh
!tests/fixtures/**/*.ep
# Error-message snapshot corpus (issue #34): fixtures, blessed snapshots,
# and corpus docs are sources, not build outputs.
!tests/error_snapshots/**/*.ep
!tests/error_snapshots/**/*.txt
!tests/error_snapshots/**/*.md
bench/**
!bench/**/
!bench/**/*.nim
!bench/**/*.md
!bench/**/*.ep
# Examples dir: keep sources, ignore built outputs
examples/**
!examples/**/
!examples/**/*.nim
!examples/**/*.ep
!examples/**/*.md
# Shed metadata sidecars (issue #133): written by the eponymBlock macro
# next to the calling Nim file for the LSP server; regenerated on compile.
*.sheds.json
# Exception (issue #502): the integration-test shed fixture ships its
# pre-generated sidecar so the tests never compile fixtures.
!editors/vscode/test/integration/fixtures/*.sheds.json

# VSCode extension build (issue #136)
editors/vscode/node_modules/
editors/vscode/out/
editors/vscode/*.vsix
# VS Code integration-test cache (issue #502): downloaded desktop build.
editors/vscode/.vscode-test/
editors/vscode/test/integration/.vscode-test-user-data/
editors/vscode/test/integration/.vscode-test-extensions/
