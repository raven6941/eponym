nimcache/
*.o
# Compiled Nim binaries: `nim c` drops extensionless binaries next to
# sources. Ignore all extensionless files under src/ and tests/, keeping
# directories and .nim sources.
src/**
!src/**/
!src/**/*.nim
!src/**/*.md
tests/**
!tests/**/
!tests/**/*.nim
!tests/**/*.sh
# Error-message snapshot corpus (issue #34): fixtures, blessed snapshots,
# and corpus docs are sources, not build outputs.
!tests/error_snapshots/**/*.ep
!tests/error_snapshots/**/*.txt
!tests/error_snapshots/**/*.md
bench/**
!bench/**/
!bench/**/*.nim
!bench/**/*.md
# Examples dir: keep sources, ignore built outputs
examples/**
!examples/**/
!examples/**/*.nim
!examples/**/*.ep
!examples/**/*.md
# Shed metadata sidecars (issue #133): written by the shedsBlock macro
# next to the calling Nim file for the LSP server; regenerated on compile.
*.sheds.json

# VSCode extension build (issue #136)
editors/vscode/node_modules/
editors/vscode/out/
