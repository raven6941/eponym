{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Eponym LSP",
      "type": "shell",
      "command": "nim c --hints:off --path:src --path:src/eponym src/eponym/lsp.nim",
      "options": { "cwd": "${workspaceFolder}/../.." },
      "problemMatcher": []
    },
    {
      "label": "Build Eponym Sheds extension",
      "type": "npm",
      "script": "build",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"]
    },
    {
      "label": "Build Eponym Sheds extension and LSP",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Build Eponym LSP",
        "Build Eponym Sheds extension"
      ],
      "problemMatcher": []
    },
    {
      "label": "Build and package Eponym Sheds VSIX",
      "type": "shell",
      "command": "npm run build && npx @vscode/vsce package",
      "options": { "cwd": "${workspaceFolder}/editors/vscode" },
      "presentation": { "reveal": "always", "panel": "new" },
      "problemMatcher": []
    }
  ]
}
