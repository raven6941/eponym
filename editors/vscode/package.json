{
  "name": "eponym-sheds",
  "displayName": "Eponym Sheds",
  "description": "Renders Eponym shed proof states (Epigram-style 2D boxes) from the eponym LSP server.",
  "version": "0.1.19",
  "publisher": "raven6941",
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onCommand:eponym.showShedLayout",
    "onCommand:eponym.expandShed",
    "onLanguage:nim"
  ],
  "contributes": {
    "languages": [
      {
        "id": "nim",
        "aliases": [
          "Nim",
          "nim"
        ],
        "extensions": [
          ".nim",
          ".nims",
          ".nimble"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "commands": [
      {
        "command": "eponym.showShedLayout",
        "title": "Eponym: Show shed layout",
        "category": "Eponym"
      },
      {
        "command": "eponym.expandShed",
        "title": "Eponym: Expand inline shed view",
        "category": "Eponym"
      },
      {
        "command": "eponym.collapseShed",
        "title": "Eponym: Collapse inline shed view",
        "category": "Eponym"
      },
      {
        "command": "eponym.shedIntro",
        "title": "Eponym: Introduce goal binder (inline)",
        "category": "Eponym"
      },
      {
        "command": "eponym.shedRefine",
        "title": "Eponym: Refine shed (inline)",
        "category": "Eponym"
      },
      {
        "command": "eponym.shedCaseSplit",
        "title": "Eponym: Case-split shed (inline)",
        "category": "Eponym"
      },
      {
        "command": "eponym.shedGive",
        "title": "Eponym: Give shed (inline)",
        "category": "Eponym"
      }
    ],
    "keybindings": [
      {
        "command": "eponym.expandShed",
        "key": "ctrl+shift+s",
        "when": "editorTextFocus"
      },
      {
        "command": "eponym.collapseShed",
        "key": "escape",
        "when": "eponym.shedExpanded && editorTextFocus"
      },
      {
        "command": "eponym.shedIntro",
        "key": "i",
        "when": "eponym.shedExpanded && editorTextFocus"
      },
      {
        "command": "eponym.shedRefine",
        "key": "r",
        "when": "eponym.shedExpanded && editorTextFocus"
      },
      {
        "command": "eponym.shedCaseSplit",
        "key": "c",
        "when": "eponym.shedExpanded && editorTextFocus"
      },
      {
        "command": "eponym.shedGive",
        "key": "g",
        "when": "eponym.shedExpanded && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Eponym Sheds",
      "properties": {
        "eponym.lspServerPath": {
          "type": "string",
          "default": "",
          "description": "Optional path to an existing Eponym LSP server binary. By default the extension finds a repository checkout or Nimble-installed Eponym source and builds the server into extension storage on first use."
        },
        "eponym.nimPath": {
          "type": "string",
          "default": "",
          "description": "Nim binary used to build the LSP server and compile shed files. Defaults to `nim` on PATH, then common Nim install locations."
        },
        "eponym.inlineShed.showButtons": {
          "type": "boolean",
          "default": true,
          "description": "Show action labels in the inline shed view. When false, only the keybinding hints are shown."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p .",
    "smoke": "node out/smoke.js",
    "test:headless": "node test/inline-shed.test.js && node test/state-history.test.js && node test/sidecar.test.js && node test/server-setup.test.js"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "typescript": "^5.3.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/raven6941/eponym"
  }
}
