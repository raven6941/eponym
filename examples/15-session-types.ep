# Session types (indexed protocol descriptions). Tests issue #28.
# Experiment: session-typed channels
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe
#
# A session type describes a communication protocol. A channel indexed by
# a session type ensures at compile time that send/recv follow the protocol.
# Violations (wrong order, use after close) are elaboration errors, not
# runtime failures.

data Nat : ? where
| zero : Nat
| suc (n : Nat) : Nat

# Session protocol descriptions: what comes next on the channel
data Session : ? where
| sendS (A : ?) (s : Session) : Session
| recvS (A : ?) (s : Session) : Session
| endS : Session

# Channel indexed by current session state
data Chan : Session -> ? where
| mkChan (s : Session) : Chan s

# Operations (mock implementations for the demo; a real library would
# bind these to socket operations). The types enforce the protocol:
# - sendNat takes Chan (sendS Nat S), returns Chan S
# - recvNat takes Chan (recvS Nat S), returns (Nat, Chan S)
# - closeOp takes Chan endS (nothing else type-checks)
proc sendNat (S : Session) (x : Nat) (ch : Chan (sendS Nat S)) : Chan S =
  mkChan S
proc recvNat (S : Session) (ch : Chan (recvS Nat S)) : Sig (x : Nat). Chan S =
  (zero, mkChan S)
proc closeOp (ch : Chan endS) : Nat =
  zero

# Protocol: send a Nat, receive a Nat, then done
proc proto : Session =
  sendS Nat (recvS Nat endS)

# Correct client: follows the protocol exactly
# ch : Chan (sendS Nat (recvS Nat endS))
#  -> sendNat gives Chan (recvS Nat endS)
#  -> recvNat gives (Nat, Chan endS)
#  -> closeOp consumes Chan endS
proc client (ch : Chan proto) : Nat =
  let ch1 = sendNat (recvS Nat endS) zero ch in
  let p = recvNat endS ch1 in
  closeOp (snd p)

# The following are REJECTED at compile time (uncomment to verify):
#
# Violation 1: recv before send (wrong order)
# proc badClient1 (ch : Chan proto) : Nat =
#   let p = recvNat (sendS Nat endS) ch in
#   zero
# Error: inferred type (Chan proto) does not match expected type
#        (Chan (recvS Nat (sendS Nat endS)))
#
# Violation 2: send on a closed channel
# proc badClient2 (ch : Chan endS) : Chan endS =
#   sendNat endS zero ch
# Error: inferred type (Chan endS) does not match expected type
#        (Chan (sendS Nat endS))
#
# Violation 3: use after close (double close)
# proc badClient3 (ch : Chan proto) : Nat =
#   let ch1 = sendNat (recvS Nat endS) zero ch in
#   let p = recvNat endS ch1 in
#   let c = closeOp (snd p) in
#   closeOp (snd p)
# Error: (snd p) : Chan endS, but closeOp already consumed it;
#        the second closeOp gets Chan endS which is fine, but the
#        linearity violation (using p twice) is not yet caught —
#        see issue #28 notes on the affinity hole.
