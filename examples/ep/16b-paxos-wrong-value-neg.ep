# Negative test for dependent-session Paxos: wrong value in accept.
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
#
# A proposer that tries to accept with a ticket for a different value is
# rejected: sendAccept demands AcceptMsg(fst(fst(pv))) -- the ticket for
# the promised value -- but the proposer supplies a ticket for another
# value. Since AcceptMsg has no constructors, no such term exists; the
# test uses a postulate to simulate the forgery attempt, which fails
# because the postulate's type doesn't match.
import "../../lib/nat.ep"

data Session : ? where
| sendD (A : ?) (k : A -> Session) : Session
| recvD (A : ?) (k : A -> Session) : Session
| endS : Session

data Chan : Session -> ? where
| mkChan (s : Session) : Chan s

postulate AcceptMsg : Nat -> ?

proc propAfterAccept (a : Nat) : Session = endS
proc propAfterPromise (pr : Sig (v : Nat). AcceptMsg v) : Session =
  sendD (AcceptMsg (fst pr)) (lam (t : AcceptMsg (fst pr)). recvD Nat propAfterAccept)
proc propAfterPrepare (n : Nat) : Session =
  recvD (Sig (v : Nat). AcceptMsg v) propAfterPromise
proc propProto : Session =
  sendD Nat propAfterPrepare

postulate sendPrepare : Pi (ch : Chan propProto). Pi (n : Nat). Chan (propAfterPrepare n)
postulate recvPromise : Pi (n : Nat). Pi (ch : Chan (propAfterPrepare n)).
  Sig (pr : Sig (v : Nat). AcceptMsg v). Chan (propAfterPromise pr)
postulate sendAccept : Pi (pv : Sig (pr : Sig (v : Nat). AcceptMsg v). Chan (propAfterPromise pr)).
  Pi (t : AcceptMsg (fst (fst pv))). Chan (recvD Nat propAfterAccept)

# Violation: the proposer tries to forge a ticket for a different value.
# We postulate a fake ticket source; the accept demands AcceptMsg(fst(fst(pv)))
# but fakeTicket gives AcceptMsg(suc(fst(fst(pv)))) -- a different value.
# Expected error: type mismatch (AcceptMsg X vs AcceptMsg (suc X)).
postulate fakeTicket : Pi (pv : Sig (pr : Sig (v : Nat). AcceptMsg v). Chan (propAfterPromise pr)).
  AcceptMsg (suc (fst (fst pv)))

proc badProposer (ch : Chan propProto) : Chan (recvD Nat propAfterAccept) =
  let ch1 = sendPrepare ch zero in
  let pv = recvPromise zero ch1 in
  sendAccept pv (fakeTicket pv)
