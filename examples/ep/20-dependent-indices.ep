# Dependent index telescopes (issue #112): a later index's type may mention
# an earlier index binder: `Pi (n : Nat). Vec A n -> ?`.
# The generated eliminator renames index binders to i0, i1, ... and must
# substitute the old names into later index domains; without the fix the
# motive C is ill-scoped (unbound `n`).
# Issue: 112
import "../../lib/nat.ep"

data Vec (A : ?) : Nat -> ? where
| nil : Vec A zero
| cons (n : Nat) (x : A) (xs : Vec A n) : Vec A (suc n)

data All (A : ?) (P : A -> ?) : Pi (n : Nat). Vec A n -> ? where
| allNil : All A P zero (nil A)
| allCons (n : Nat) (x : A) (xs : Vec A n) (px : P x) (pxs : All A P n xs) : All A P (suc n) (cons A n x xs)

proc witness : All Nat (lam (x : Nat). Nat) (suc (suc zero)) (cons Nat (suc zero) (suc zero) (cons Nat zero zero (nil Nat))) =
  allCons Nat (lam (x : Nat). Nat) (suc zero) (suc zero) (cons Nat zero zero (nil Nat)) (suc zero) (allCons Nat (lam (x : Nat). Nat) zero zero (nil Nat) zero (allNil Nat (lam (x : Nat). Nat)))

proc allLen (n : Nat) (v : Vec Nat n) (a : All Nat (lam (x : Nat). Nat) n v) : Nat =
  allElim Nat (lam (x : Nat). Nat) (lam (i : Nat). lam (w : Vec Nat i). lam (u : All Nat (lam (x : Nat). Nat) i w). Nat) zero (lam (i : Nat). lam (x : Nat). lam (xs : Vec Nat i). lam (px : Nat). lam (pxs : All Nat (lam (x : Nat). Nat) i xs). lam (ih : Nat). suc ih) n v a

proc lenIsTwo : Nat =
  allLen (suc (suc zero)) (cons Nat (suc zero) (suc zero) (cons Nat zero zero (nil Nat))) witness
