# Tactics: `byTac(...)` runs Nim tactics against the expected type.
# Experiment: 6
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `Univ` = universe
# `byTac(tac)` runs a tactic (e.g. `byTac(refl)`); built-ins: `refl`, `assumption`
# `byTac(refl)` proves equalities by reflexivity (up to conversion).
# `byTac(assumption)` finds a matching hypothesis.

postulate(Int, Univ)

data(Eq, [A: Univ, x: A], A -> Univ) where
| refl : Eq A x x

proc pf1 : Eq Int 42 42= byTac(refl)

proc pf2 : Eq Int (addInt 20 22) 42= byTac(refl)

proc id (x : Int) : Int= byTac(assumption)
