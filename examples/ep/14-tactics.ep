# Tactics: `by` blocks run Nim tactics against the expected type.
# Experiment: 6
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe (in ettBlock: `Univ`)
# `by tac` runs a tactic (e.g. `by refl`); built-ins: `refl`, `assumption`
# `by refl` proves equalities by reflexivity (up to conversion).
# `by assumption` finds a matching hypothesis.

postulate Int : ?

data Eq (A : ?) (x : A) : A -> ? where
| refl : Eq A x x

proc pf1 : Eq Int 42 42= by refl

proc pf2 : Eq Int (addInt 20 22) 42= by refl

proc id (x : Int) : Int= by assumption
