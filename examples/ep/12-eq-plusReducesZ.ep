# Propositional equality: Eq, refl, J, cong, plusReducesZ.
# Experiment: 12
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe (in eponymBlock: `Univ`)
# `data T : ? where` defines inductive types; in eponymBlock: `data(T, Univ):` + indented `proc` ctors
# Eq is an indexed family; refl typechecks up to conversion
# (not just syntactic equality). J (eqElim) is the eliminator.
# plusReducesZ is the Idris benchmark: (n : Nat) -> n = plus n Z.
import "../../lib/nat.ep"

data Eq (A : ?) (x : A) : A -> ? where
| refl : Eq A x x

proc cong (A : ?) (B : ?) (f : A -> B) (x : A) (y : A) (p : Eq A x y)
    : Eq B (f x) (f y) =
  eqElim A x (lam (z : A). lam (q : Eq A x z). Eq B (f x) (f z))
         (refl B (f x)) y p

proc plusReducesZ (n : Nat) : Eq Nat n (add n zero) =
  natElim (lam (m : Nat). Eq Nat m (add m zero))
          (refl Nat zero)
          (lam (k : Nat). lam (ih : Eq Nat k (add k zero)).
            cong Nat Nat (lam (x : Nat). suc x) k (add k zero) ih)
          n
