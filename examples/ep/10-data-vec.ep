# Vectors (indexed family). Tests indexed data and eliminator computation.
# Experiment: 10
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe (in eponymBlock: `Univ`)
# `data T : ? where` defines inductive types; in eponymBlock: `data(T, Univ):` + indented `proc` ctors
import "../../lib/nat.ep"

data Vec (A : ?) : Nat -> ? where
| nil : Vec A zero
| cons (n : Nat) (x : A) (xs : Vec A n) : Vec A (suc n)
proc v2 : Vec Nat (suc (suc zero)) =
  cons Nat (suc zero) (suc zero) (cons Nat zero zero (nil Nat))
proc lenIsTwo : Nat =
  vecElim Nat (lam (i : Nat). lam (v : Vec Nat i). Nat)
            zero
            (lam (i : Nat). lam (x : Nat). lam (xs : Vec Nat i). lam (ih : Nat). suc ih)
            (suc (suc zero)) v2
