# Vec append with conversion. Tests Experiment 5b: checkTm uses full conversion.
# Experiment: 11
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `Type 0` = universe (in eponymBlock: `Univ`)
# `data T : Type 0 where` defines inductive types; in eponymBlock: `data(T, Univ):` + indented `proc` ctors
import "../../lib/nat.ep"

data Vec (A : Type 0) : Nat -> Type 0 where
| nil : Vec A zero
| cons (n : Nat) (x : A) (xs : Vec A n) : Vec A (suc n)
proc vnil : Vec Nat (add zero zero) =
  nil Nat
proc constNil (A : Type 0) (x : A) : Vec A (add zero zero) =
  nil A
proc append {A : Type 0} {m : Nat} {n : Nat} (xs : Vec A m) (ys : Vec A n)
    : Vec A (add m n) =
  vecElim A (lam (i : Nat). lam (v : Vec A i). Vec A (add i n))
            ys
            (lam (i : Nat). lam (x : A). lam (xs : Vec A i).
              lam (ih : Vec A (add i n)). cons A (add i n) x ih)
            m xs
