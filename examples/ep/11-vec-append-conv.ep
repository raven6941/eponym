# Vec append with conversion. Tests Experiment 5b: checkTm uses full conversion.
# Experiment: 11
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `Univ` = universe
# `data(T, Univ) where` defines inductive types
import "../../lib/nat.ep"

data(Vec, [A: Univ], Nat -> Univ) where
| nil : Vec A zero
| cons (n : Nat) (x : A) (xs : Vec A n) : Vec A (suc n)
proc vnil : Vec Nat (add zero zero) =
  nil Nat
proc constNil (A : Univ) (x : A) : Vec A (add zero zero) =
  nil A
proc append {A : Univ} {m : Nat} {n : Nat} (xs : Vec A m) (ys : Vec A n)
    : Vec A (add m n) =
  vecElim A (lam(i, Nat, lam(v, Vec A i, Vec A (add i n))))
            ys
            (lam(i, Nat, lam(x, A, lam(xs, Vec A i, lam(ih, Vec A (add i n), cons A (add i n) x ih)))))
            m xs
