# Naturals via data declaration. Tests Experiment 5 desugaring.
# Experiment: 09
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe (in eponymBlock: `Univ`)
# `data T : ? where` defines inductive types; in eponymBlock: `data(T, Univ):` + indented `proc` ctors

data Nat : ? where
| zero : Nat
| suc (n : Nat) : Nat
proc two : Nat= suc (suc zero)
proc add (m : Nat) (n : Nat) : Nat =
  natElim (lam (u : Nat). Nat) m (lam (p : Nat). lam (ih : Nat). suc ih) n
proc four : Nat= add two two
