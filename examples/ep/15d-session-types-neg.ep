# Negative test for session types: send on a closed channel.
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
# A channel in end-state cannot be used where send-state is expected.
import "../../lib/nat.ep"
import "../../lib/session.ep"

# Violation 2: send on a closed (endS) channel.
# Expected error: inferred type (Chan endS) does not match expected type
# (Chan (sendS Nat endS)) — distinct constructors.
proc badClient2 (1 ch : Chan endS) : Chan endS =
  sendNat zero ch
