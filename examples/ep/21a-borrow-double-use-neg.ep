# Negative test for borrow checking (Issue #122): a borrow used twice.
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
#
# `b2` is consumed by the inner `endB` and then used again by the outer
# one. Expected error: linear variable 'b2' used 2 times (expected
# exactly once), from the in-judgment quantity enforcement (Issue #66).
import "../../lib/nat.ep"

postulate Res : ?
postulate Borrow : ?

postulate withBorrow : Pi (1 r : Res). Pi (k : Pi (1 b : Borrow). Nat). Nat
postulate readB : Pi (1 b : Borrow).
  Pi (k : Pi (v : Nat). Pi (1 b2 : Borrow). Nat). Nat
postulate endB : Pi (1 b : Borrow). Pi (v : Nat). Nat

# Violation: double use of the borrow b2.
proc badDouble (1 r : Res) : Nat =
  withBorrow r (lam (b : Borrow).
    readB b (lam (v : Nat). lam (b2 : Borrow).
      endB b2 (endB b2 v)))
