# Issue #88: Usage-indexed operators — the quantity-polymorphism workaround.
#
# QTT has no quantity polymorphism: a function cannot abstract over the
# quantity of its argument, so library code that should work at any quantity
# must be written once per quantity (map0/map1/mapW below). The workaround
# (Brady 2021, Usage-indexed L monad): reify quantities as *values* (Usage)
# and compute types from them. `mapU` is written ONCE, indexed by a Usage
# value; the function-argument type is computed from that value by
# `mapCont`, whose three cases select the literal binder quantity.
#
# Honest limit (per the concept note): this recovers expressiveness, not
# quantity-polymorphic *inference* — each new quantity combination still
# needs its case in the computing function. The boilerplate moves into
# `mapCont` rather than disappearing; what the library API gains is one
# name, one signature shape, and one place to document.
import "../../lib/nat.ep"
import "../../lib/list.ep"
import "../../lib/usage.ep"

# --- The computing function: the heart of the pattern -----------------------
# The function-argument type selected by the usage value. Each case pins the
# literal binder quantity; `mapU` below dispatches on `u` so that in each
# branch `mapCont u A B` reduces (delta + iota) to the concrete Pi type.
proc mapCont (u : Usage) (A : Univ) (B : Univ) : Univ =
  usageElimLarge (lam(w, Usage, Univ))
    (Pi(0 x: A, B))
    (Pi(1 x: A, B))
    (Pi(x: A, B))
    u

# --- One operator, written once, usable at 0, 1, and ω -----------------------
# Note the shape (Brady's pattern): the case split on `u` comes *first* and
# each branch builds the fully specialized operator. The motive computes the
# operator's type from `u`; in each branch `mapCont U0/U1/UOmega A B`
# reduces (delta + iota) to the concrete Pi, so the branch ascriptions
# check by conversion (this needs the #88 elaborator fix: ascribed lambda
# domains are compared by convElab, since the syntactic unifier cannot see
# through the definition).
proc mapU (u : Usage) (A : Univ) (B : Univ) : mapCont u A B -> List A -> List B =
  usageElim (lam(w, Usage, mapCont w A B -> List A -> List B))
    (lam(f0, Pi(0 x: A, B), lam(xs0, List A, listElim A (lam(v, List A, List B)) (nil B) (lam(x, A, lam(tl, List A, lam(ih, List B, cons B (f0 x) ih)))) xs0)))
    (lam(f1, Pi(1 x: A, B), lam(xs1, List A, listElim A (lam(v, List A, List B)) (nil B) (lam(x, A, lam(tl, List A, lam(ih, List B, cons B (f1 x) ih)))) xs1)))
    (lam(f2, Pi(x: A, B), lam(xs2, List A, listElim A (lam(v, List A, List B)) (nil B) (lam(x, A, lam(tl, List A, lam(ih, List B, cons B (f2 x) ih)))) xs2)))
    u

# --- Tests: all three quantities elaborate and evaluate ---------------------
# U0: the function must not use its argument (erased); result is all zeros.
proc testU0 : List Nat =
  mapU U0 Nat Nat (lam(0 n, Nat, zero)) (cons Nat (suc zero) (nil Nat))

# U1: the function must use its argument exactly once.
proc testU1 : List Nat =
  mapU U1 Nat Nat (lam(1 n, Nat, suc n)) (cons Nat zero (nil Nat))

# UOmega: unrestricted, the ordinary map.
proc testUOmega : List Nat =
  mapU UOmega Nat Nat (lam(n, Nat, suc (suc n))) (cons Nat zero (nil Nat))

# --- Evaluation checks: each usage site must REDUCE to the expected list ---
# `refl` typechecks up to conversion (lib/eq.ep), so these procs elaborate
# only if the test terms actually evaluate to the stated lists. This is the
# "evaluate identically" half of the acceptance criterion, checked in-run.
proc evalU0 : Eq (List Nat) testU0 (cons Nat zero (nil Nat)) =
  refl (List Nat) (cons Nat zero (nil Nat))

proc evalU1 : Eq (List Nat) testU1 (cons Nat (suc zero) (nil Nat)) =
  refl (List Nat) (cons Nat (suc zero) (nil Nat))

proc evalUOmega : Eq (List Nat) testUOmega (cons Nat (suc (suc zero)) (nil Nat)) =
  refl (List Nat) (cons Nat (suc (suc zero)) (nil Nat))

# --- Baseline: the same operator written three times (the pre-#88 world) ----
# Measurement (definitions / non-blank non-comment lines):
#   baseline: 3 top-level operators (map0, map1, mapW), each with its own
#             signature and full recursive body.
#   indexed:  1 operator (mapU, signature written once) + 1 computing
#             function (mapCont, 3 one-line cases) + 3 branch bodies.
# The API surface shrinks 3 → 1; the per-quantity bodies move into mapU's
# branches. Net line delta is small — the win is one name to learn,
# document, and maintain, exactly the library-scaling wall from #88.
proc map0 (A : Univ) (B : Univ) (f : Pi(0 x: A, B)) (xs : List A) : List B =
  listElim A (lam(v, List A, List B))
    (nil B)
    (lam(x, A, lam(tl, List A, lam(ih, List B, cons B (f x) ih))))
    xs

proc map1 (A : Univ) (B : Univ) (f : Pi(1 x: A, B)) (xs : List A) : List B =
  listElim A (lam(v, List A, List B))
    (nil B)
    (lam(x, A, lam(tl, List A, lam(ih, List B, cons B (f x) ih))))
    xs

proc mapW (A : Univ) (B : Univ) (f : A -> B) (xs : List A) : List B =
  listElim A (lam(v, List A, List B))
    (nil B)
    (lam(x, A, lam(tl, List A, lam(ih, List B, cons B (f x) ih))))
    xs
