# Negative test for session types: recv before send (wrong order).
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
# A channel in send-state cannot be used where recv-state is expected:
# the session indices `sendS Nat endS` and `recvS Nat endS` are distinct
# constructors, so conversion fails (noConfusion).
import "../../lib/nat.ep"
import "../../lib/session.ep"

# Violation 1: recv on a channel whose protocol says send first.
# Expected error: inferred type (Chan (sendS Nat endS)) does not match
# expected type (Chan (recvS Nat endS)) — distinct constructors.
proc badClient1 (1 ch : Chan (sendS Nat endS)) : Sig(x: Nat, Chan endS) =
  recvNat ch
