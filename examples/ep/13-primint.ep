# Primitive efficient integers: literals and ops compute via host.
# Experiment: 11
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `Univ` = universe
# No unary s(s(z)) — 42 is a machine integer, addInt computes directly.

postulate(Int, Univ)

data(Eq, [A: Univ, x: A], A -> Univ) where
| refl : Eq A x x

proc sum : Int= addInt 42 17
proc pf : Eq Int sum 59= refl Int sum

proc diff : Int= subInt 100 58
proc pf2 : Eq Int diff 42= refl Int diff

proc prod : Int= mulInt 6 7
proc pf3 : Eq Int prod 42= refl Int prod
