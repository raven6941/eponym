# Negative test for typestate (issue #481): send before connect.
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
# sendH requires Sock connP; the handle here is still Sock unconnP.
import "../../lib/nat.ep"
import "../../lib/typestate.ep"

# Expected error: inferred type (Sock unconnP) does not match expected
# type (Sock connP): noConfusion, distinct constructors.
proc badSendBeforeConnect (1 s : Sock unconnP) : Sock connP =
  sendH zero s
