# Negative test: vDot demands equal dimensions (Issue #110).
# A dimension mismatch is a compile-time error here; NumPy would raise
# it at runtime. `VExpr zero` does not convert with `VExpr (suc zero)`.
import "../../lib/nat.ep"

data VExpr : Nat -> Type 0 where
| vVar (n : Nat) : VExpr n

data CExpr : Type 0 where
| vDot (n : Nat) (e1 : VExpr n) (e2 : VExpr n) : CExpr

# Rejected: e2 has dimension zero, but n is suc zero.
proc bad : CExpr = vDot (suc zero) (vVar (suc zero)) (vVar zero)
