# Polymorphic identity with implicit arguments. Tests implicit insertion.
# Experiment: 04
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `Type 0` = universe (in eponymBlock: `Univ`)

proc polyId {A : Type 0} (x : A) : A =
  x
proc usePolyId : 1 =
  polyId <>
proc constI {A : Type 0} {B : Type 0} (x : A) (y : B) : A =
  x
proc useConstI : 1 =
  constI <> <>
proc pairSwapI {A : Type 0} {B : Type 0} (p : Sig (u : A). B) : Sig (v : B). A =
  (snd p, fst p)
proc usePairSwapI : Sig (v : 1). 1 =
  pairSwapI (<>, <>)
