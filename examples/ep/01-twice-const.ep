# Basic definitions: twice, const, pairSwap. Tests Pi types and application.
# Experiment: 01
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `Univ` = universe

proc twice (A : Univ) (f : A -> A) (x : A) : A =
  f (f x)
proc constFn (A : Univ) (B : Univ) (x : A) (y : B) : A =
  x
proc pairSwap (A : Univ) (B : Univ) (p : Sig(u: A, B)) : Sig(v: B, A) =
  (snd p, fst p)
