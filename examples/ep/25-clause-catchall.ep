# Issue #78: variable and wildcard first patterns in `def` clauses.
# A variable/wildcard first pattern covers every constructor not matched
# by an earlier clause. A variable pattern binds the whole scrutinee; in
# each generated method it is replaced by that constructor applied to the
# method's binders.

import "../../lib/nat.ep"
import "../../lib/bool.ep"

# variable pattern covers the remaining constructors
def(isZeroV, Nat -> Bool):
  clause([zero], true)
  clause([m], false)

# wildcard covers everything on its own
def(constTrue, Nat -> Bool):
  clause([_], true)

# a variable pattern stands for the scrutinee: identity rebuilds it
def(idNat, Nat -> Nat):
  clause([x], x)

# uses elaborate (the compiled eliminator applications typecheck)
proc t1 : Bool = isZeroV zero
proc t2 : Bool = isZeroV (suc zero)
proc t3 : Bool = constTrue (suc (suc zero))
proc t4 : Nat = idNat (suc zero)
