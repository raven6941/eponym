# Session types (indexed protocol descriptions). Tests issue #28.
# Experiment: session-typed channels
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe
#
# A session type describes a communication protocol. A channel indexed by
# a session type ensures at compile time that send/recv follow the protocol.
# Violations (wrong order, use after close) are elaboration errors, not
# runtime failures.
#
# The reusable session-types library lives in lib/session.ep (issue #164);
# this file is the example-specific use: one protocol and its client.
import "../../lib/nat.ep"
import "../../lib/session.ep"


# Protocol: send a Nat, receive a Nat, then done
proc proto : Session =
  sendS Nat (recvS Nat endS)

# Correct client: follows the protocol exactly
# The (1 ch) binder ensures the channel is used exactly once (Issue #64).
# Note: simplified to a single send for the linearity demo.
proc client (1 ch : Chan (sendS Nat endS)) : Chan endS =
  sendNat zero ch

# The following are REJECTED at compile time (each exercised as a negative
# test, run by tests/run_examples.nim):
#   15b-session-types-neg.ep — double-send (linearity)
#   15c-session-types-neg.ep — recv before send (wrong order)
#   15d-session-types-neg.ep — send on a closed channel (protocol state)
#   15e-session-types-neg.ep — use after close (linearity)
#
# Violation 1: recv before send (wrong order)
# proc badClient1 (1 ch : Chan (sendS Nat endS)) : Sig (x : Nat). Chan endS =
#   recvNat ch
# Error: inferred type (Chan (sendS Nat endS)) does not match expected type
#        (Chan (recvS Nat endS)): noConfusion, distinct constructors
#
# Violation 2: send on a closed channel
# proc badClient2 (1 ch : Chan endS) : Chan endS =
#   sendNat zero ch
# Error: inferred type (Chan endS) does not match expected type
#        (Chan (sendS Nat endS)): noConfusion, distinct constructors
#
# Violation 3: double-send (affinity hole, Issue #64)
# With linear binders, this is now rejected by the in-judgment quantity
# enforcement (Issue #66) — see 15b-session-types-neg.ep.
# Error: linear variable used more than once (ch)
