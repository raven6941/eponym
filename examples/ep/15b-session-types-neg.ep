# Negative test for session types: linear channel used twice.
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
# The double-send must be rejected by the in-judgment quantity enforcement
# (Issue #66), not merely by the old post-pass checker.
import "../../lib/nat.ep"
import "../../lib/session.ep"

# Violation 3: double-send on a linear channel (affinity hole, Issue #64)
# Expected error: linear variable 'ch' used 2 times (expected exactly once)
proc badClient3 (1 ch : Chan (sendS Nat endS)) : Chan endS =
  let ch1 = sendNat zero ch in
  let ch2 = sendNat zero ch in
  ch1
