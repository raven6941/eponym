# Negative test for the DCP-checked convex library (Issue #101).
# Negative tests (files named *-neg.ep) are expected to raise ElabError;
# tests/run_examples.nim verifies the rejection.
#
# The reusable convexity library lives in lib/convex.ep (issue #164);
# this file is the example-specific use: the bogus certificate.
import "../../lib/nat.ep"
import "../../lib/convex.ep"

# x*x is the classic DCP violation (CVXPY raises DCPError for it): the
# product of two variables is not certifiably convex. Here `eMul` is in
# the AST but admits no `Convex` rule, so no certificate exists. The
# bogus proof below (claiming x^2-of-var certifies x*x) is rejected:
# `Convex (eSq eVar)` does not convert with `Convex (eMul eVar eVar)`.
proc bad : CExpr = minimize (eMul eVar eVar) (cvSq eVar afVar)
