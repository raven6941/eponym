# Polymorphic identity with implicit arguments. Tests implicit insertion.
# Experiment: 04
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe (in ettBlock: `Univ`)

proc polyId {A : ?} (x : A) : A =
  x
proc usePolyId : 1 =
  polyId <>
proc constI {A : ?} {B : ?} (x : A) (y : B) : A =
  x
proc useConstI : 1 =
  constI <> <>
proc pairSwapI {A : ?} {B : ?} (p : Sig (u : A). B) : Sig (v : B). A =
  (snd p, fst p)
proc usePairSwapI : Sig (v : 1). 1 =
  pairSwapI (<>, <>)
