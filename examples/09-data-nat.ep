# Naturals via data declaration. Tests Experiment 5 desugaring.
# Experiment: 09

data Nat : ? where
| zero : Nat
| suc (n : Nat) : Nat
proc two : Nat= suc (suc zero)
proc add (m : Nat) (n : Nat) : Nat =
  natElim (lam (u : Nat). Nat) m (lam (p : Nat). lam (ih : Nat). suc ih) n
proc four : Nat= add two two
