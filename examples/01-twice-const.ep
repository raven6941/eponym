# Basic definitions: twice, const, pairSwap. Tests Pi types and application.
# Experiment: 01
# Syntax: `proc` (Nim, was `def`), `=` (Nim, was `:=`), `?` = universe (in ettBlock: `Univ`)

proc twice (A : ?) (f : A -> A) (x : A) : A =
  f (f x)
proc constFn (A : ?) (B : ?) (x : A) (y : B) : A =
  x
proc pairSwap (A : ?) (B : ?) (p : Sig (u : A). B) : Sig (v : B). A =
  (snd p, fst p)
