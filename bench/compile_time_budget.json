{
  "schema": 1,
  "measurement": {
    "compiler": "Nim 2.4.0",
    "command": "nim check",
    "baseline": "PR target commit measured on the same GitHub Actions runner",
    "referenceSnapshot": "bench/compile_time_reference.json",
    "maxRelativeRegression": 0.3,
    "minimumAbsoluteRegressionSeconds": 0.5,
    "wallClockIncludesCompilerStartup": true
  },
  "corpora": [
    {
      "name": "dependent-indices",
      "path": "examples/embedded/dependent_indices.nim",
      "runs": 3,
      "vmLoopLimit": 10000000
    },
    {
      "name": "paxos-session",
      "path": "examples/embedded/paxos_session.nim",
      "runs": 3,
      "vmLoopLimit": 10000000
    },
    {
      "name": "nat-lemmas",
      "path": "bench/compile_time_nat_lemmas.nim",
      "description": "eponymBlock importing lib/nat_lemmas.ep",
      "generateIfMissing": true,
      "runs": 2,
      "vmLoopLimit": 100000000
    }
  ]
}
